# Gmail SMTP credentials for email notifications.
# 1. Activate 2-step verification on your Google account.
# 2. Generate an app password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (with or without spaces).
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Address that receives the daily digest emails (can be the same as GMAIL_USER).
NOTIFY_EMAIL=your.email@gmail.com

# Optional: override defaults from src/config.py without editing code.
# POSTAL_CODE=83210
# RADIUS_KM=100
# MIN_PRICE=0
# MAX_PRICE=9000
# MIN_YEAR=2012
# MAX_KM=200000
